{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Directed Graph JSON",
  "type": "object",
  "required": ["layout", "layers", "nodes", "modules", "edges", "stageParabolas"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["type", "layerCount", "theme"],
      "additionalProperties": true,
      "properties": {
        "type": { "type": "string" },
        "layerCount": { "type": "integer", "const": 5 },
        "moduleRowWrap": { "type": "boolean" },
        "edgeRouting": { "type": "string" },
        "theme": {
          "type": "object",
          "required": ["defaultEdgeColor", "emphasisEdgeColor"],
          "additionalProperties": true
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/definitions/clickableNode" }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "label", "order", "kind"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "order": { "type": "integer", "minimum": 1, "maximum": 5 },
          "kind": { "type": "string" },
          "frame": { "type": "boolean" },
          "slots": { "type": "integer", "minimum": 1 },
          "wrap": { "type": "boolean" },
          "frameTitle": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "allOf": [
          { "$ref": "#/definitions/clickableNode" },
          {
            "type": "object",
            "required": ["layer", "slot"],
            "properties": {
              "layer": { "type": "string", "minLength": 1 },
              "slot": { "type": "integer", "minimum": 1 },
              "icon": { "type": "string" }
            }
          }
        ]
      }
    },
    "modules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "layer", "order", "grid", "nodes", "asset"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "layer": { "type": "string", "const": "layer.modules" },
          "order": { "type": "integer", "minimum": 1, "maximum": 4 },
          "grid": {
            "type": "object",
            "required": ["rows", "cols"],
            "properties": {
              "rows": { "type": "integer", "minimum": 1 },
              "cols": { "type": "integer", "minimum": 1 }
            }
          },
          "asset": { "$ref": "#/definitions/asset" },
          "nodes": {
            "type": "array",
            "items": {
              "allOf": [
                { "$ref": "#/definitions/clickableNode" },
                {
                  "type": "object",
                  "required": ["row", "col"],
                  "properties": {
                    "row": { "type": "integer", "minimum": 1 },
                    "col": { "type": "integer", "minimum": 1 },
                    "loop": { "type": "boolean" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "color": { "type": "string" },
          "direction": { "type": "string" }
        }
      }
    },
    "stageParabolas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "through", "to"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "through": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "clickableNode": {
      "type": "object",
      "required": ["id", "label", "asset"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "asset": { "$ref": "#/definitions/asset" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["name", "type", "dependencies", "links", "stages", "effect", "implemented", "note"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["Skill", "MCP", "工具", "规约", "数据资产", "测试集", "其他"]
        },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": true,
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "minLength": 1 }
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["理解", "规划", "执行", "验证", "常驻"]
          }
        },
        "effect": { "type": "string", "minLength": 1 },
        "implemented": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  }
}
